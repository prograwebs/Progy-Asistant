# Supabase Auth + REST
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-legacy-anon-key

# OpenAI - reasoning, structured extraction and transcription
OPENAI_API_KEY=your-openai-api-key
OPENAI_ASSISTANT_MODEL=gpt-5-mini
OPENAI_CATALOG_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=low

# Optional internal cost estimates
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# OPENAI_AUDIO_INPUT_USD_PER_MILLION=

# ElevenLabs - voice catalogue, previews and speech generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-default-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_USD_PER_1000_CHARS=

# Meta / WhatsApp Embedded Signup
# Keep disabled until the external app review is complete.
NEXT_PUBLIC_WHATSAPP_ENABLED=false
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Public application origin
# Local development: http://localhost:4173
# Production: https://progy.prograwebs.com
PROGY_APP_URL=http://localhost:4173

# Optional: keep multiple voice tests enabled while validating locally.
# Never enable this in production.
# PROGY_UNLIMITED_VOICE_TESTS=true
