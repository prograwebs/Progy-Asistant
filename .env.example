# Supabase Auth (publishable key preferred; legacy anon key also supported)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-legacy-anon-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_ASSISTANT_MODEL=gpt-5-mini
OPENAI_CATALOG_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=low

# Legacy/fallback browser Realtime test. The primary Progy test flow uses
# transcription + reasoning + the ElevenLabs voice selected by the business.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin

# Optional provider-rate inputs used only to estimate internal usage costs.
# Leave them unset until PrograWebs defines the rates it wants to track.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# OPENAI_AUDIO_INPUT_USD_PER_MILLION=

# ElevenLabs voices and speech generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-default-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_USD_PER_1000_CHARS=

# Meta / WhatsApp Embedded Signup
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
# META_APP_ID=
# META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Public origin used for Supabase redirects and external callbacks
PROGY_APP_URL=http://localhost:4173
