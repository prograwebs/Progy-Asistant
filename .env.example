# Supabase Auth (publishable key preferred; legacy anon key also supported)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_ANON_KEY=your-legacy-anon-key

# OpenAI Realtime
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# ElevenLabs voice previews and WhatsApp Agents (voice ID is optional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-default-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Public origin used for Supabase redirects
PROGY_APP_URL=http://localhost:4173
